# Model weights are never committed. The evaluator fetches them via download_model.sh.
model/*
!model/.gitkeep
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# Profiler output. benchmarks/ is committed evidence and deliberately not ignored.
submission.json
audit.json
verdict.json
artifacts/

# Local llama.cpp binaries (downloaded, not source)
tools/

# Training intermediates
checkpoints/
outputs/
merged/
wandb/

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.uv-cache/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Datasets: keep curated seed + build recipe, ignore bulk downloads and caches
data/raw/
data/cache/
data/build/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
